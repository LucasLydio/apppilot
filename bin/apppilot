#!/usr/bin/env bash

set -Eeuo pipefail

APPPILOT_VERSION="0.2.0-dev"
APPPILOT_JSON=0
APPPILOT_QUIET=0
APPPILOT_NON_INTERACTIVE=0
APPPILOT_DRY_RUN=0

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd -- "$(dirname -- "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" == /* ]] || script_source="$script_dir/$script_source"
done
script_dir="$(cd -- "$(dirname -- "$script_source")" && pwd)"
APPPILOT_ROOT="$(cd -- "$script_dir/.." && pwd)"
export APPPILOT_ROOT APPPILOT_JSON APPPILOT_QUIET APPPILOT_NON_INTERACTIVE APPPILOT_DRY_RUN

# shellcheck source=src/core/exit-codes.sh
. "$APPPILOT_ROOT/src/core/exit-codes.sh"
# shellcheck source=src/utils/json.sh
. "$APPPILOT_ROOT/src/utils/json.sh"
# shellcheck source=src/utils/colors.sh
. "$APPPILOT_ROOT/src/utils/colors.sh"
# shellcheck source=src/utils/logger.sh
. "$APPPILOT_ROOT/src/utils/logger.sh"
# shellcheck source=src/utils/ui.sh
. "$APPPILOT_ROOT/src/utils/ui.sh"
# shellcheck source=src/core/output.sh
. "$APPPILOT_ROOT/src/core/output.sh"
# shellcheck source=src/utils/validator.sh
. "$APPPILOT_ROOT/src/utils/validator.sh"
# shellcheck source=src/core/config.sh
. "$APPPILOT_ROOT/src/core/config.sh"
# shellcheck source=src/core/lock.sh
. "$APPPILOT_ROOT/src/core/lock.sh"
# shellcheck source=src/core/app-config.sh
. "$APPPILOT_ROOT/src/core/app-config.sh"
