. "$APPPILOT_ROOT/src/commands/validate.sh"
# shellcheck source=src/commands/overview.sh
. "$APPPILOT_ROOT/src/commands/overview.sh"

usage() {
  ui_banner
  ui_section "Usage"
  printf '  apppilot [global flags] <command> [arguments]\n'
  ui_section "Core"
  printf '  %-34s %s\n' 'init' 'Create AppPilot config/state'
  printf '  %-34s %s\n' 'overview' 'Show a screenshot-friendly summary'
  printf '  %-34s %s\n' 'validate' 'Validate config and registry'
  printf '  %-34s %s\n' 'doctor' 'Run host and app diagnostics'
  printf '  %-34s %s\n' 'security audit' 'Run read-only security checks'
  ui_section "Applications"
  printf '  %-34s %s\n' 'add [--name <app> ...]' 'Register PM2 or Compose app'
  printf '  %-34s %s\n' 'add-static [--name <app> ...]' 'Register static frontend app'
  printf '  %-34s %s\n' 'add --env-from-example' 'Copy .env.example to .env'
  printf '  %-34s %s\n' 'env init <app>' 'Create .env from .env.example'
  printf '  %-34s %s\n' 'clone <repo> <name>' 'Clone an app into ~/apps'
  printf '  %-34s %s\n' 'expose <app> --domain <domain>' 'Create Nginx exposure'
  printf '  %-34s %s\n' 'list' 'List registered apps'
  printf '  %-34s %s\n' 'status <app> [--full]' 'Show app status table/details'
  printf '  %-34s %s\n' 'health <app> [--url <url>]' 'Check runtime and HTTP health'
  printf '  %-34s %s\n' 'logs <app>' 'Show app logs'
  printf '  %-34s %s\n' 'start|stop|restart <app>' 'Manage an app'
  printf '  %-34s %s\n' 'deploy <app>' 'Pull, test, build, restart'
  printf '  %-34s %s\n' 'deploy history <app>' 'Show deploy history'
  printf '  %-34s %s\n' 'deploy rollback <app>' 'Rollback to a previous revision'
  printf '  %-34s %s\n' 'backup snapshot <app>' 'Create an app backup archive'
  printf '  %-34s %s\n' 'backup list <app>' 'List backup snapshots'
  printf '  %-34s %s\n' 'remove <app> --yes' 'Remove app from registry'
  ui_section "Adapters"
  printf '  %-34s %s\n' 'adapters list' 'Show adapter availability'
  printf '  %-34s %s\n' 'adapters install [git|nginx|certbot|pm2|compose|all]' 'Install adapter dependencies'
  printf '  %-34s %s\n' 'adapters updates' 'Check adapter update status'
  ui_section "Global Flags"
  printf '  %-18s %s\n' '--json' 'Print JSON only'
  printf '  %-18s %s\n' '--quiet' 'Suppress decoration'
  printf '  %-18s %s\n' '--non-interactive' 'Never prompt'
  printf '  %-18s %s\n' '--dry-run' 'Plan mutations without changes'
}

parse_args() {
  APPPILOT_POSITIONAL=()
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --json) APPPILOT_JSON=1; shift ;;
      --quiet) APPPILOT_QUIET=1; shift ;;
      --non-interactive) APPPILOT_NON_INTERACTIVE=1; shift ;;
      --dry-run) APPPILOT_DRY_RUN=1; shift ;;
      --help|-h) APPPILOT_POSITIONAL+=("--help"); shift ;;
      --version) APPPILOT_POSITIONAL+=("--version"); shift ;;
      *) APPPILOT_POSITIONAL+=("$1"); shift ;;
    esac
  done
  export APPPILOT_JSON APPPILOT_QUIET APPPILOT_NON_INTERACTIVE APPPILOT_DRY_RUN
}

main() {
  parse_args "$@"
  config_setup_paths
  color_setup

  local command="${APPPILOT_POSITIONAL[0]:---help}"
  local args=("${APPPILOT_POSITIONAL[@]:1}")

  case "$command" in
    --help|-h) usage ;;
    --version) printf '%s\n' "$APPPILOT_VERSION" ;;
    init) cmd_init "${args[@]}" ;;
    add) cmd_add "${args[@]}" ;;
    add-static) cmd_add_static "${args[@]}" ;;
    clone) cmd_clone "${args[@]}" ;;
    expose) cmd_expose "${args[@]}" ;;
    env) cmd_env "${args[@]}" ;;
    remove) cmd_remove "${args[@]}" ;;
    list) cmd_list "${args[@]}" ;;
    start) cmd_start "${args[@]}" ;;
    stop) cmd_stop "${args[@]}" ;;
    restart) cmd_restart "${args[@]}" ;;
    deploy) cmd_deploy "${args[@]}" ;;
    status) cmd_status "${args[@]}" ;;
    health) cmd_health "${args[@]}" ;;
    logs) cmd_logs "${args[@]}" ;;
    backup) cmd_backup "${args[@]}" ;;
    doctor) cmd_doctor "${args[@]}" ;;
    security) cmd_security "${args[@]}" ;;
    adapters) cmd_adapters "${args[@]}" ;;
    validate) cmd_validate "${args[@]}" ;;
    overview) cmd_overview "${args[@]}" ;;
    *) output_error "Unknown command: $command" "$APPPILOT_ERR_ARGS"; return "$APPPILOT_ERR_ARGS" ;;
  esac
}

main "$@"
