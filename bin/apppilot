. "$APPPILOT_ROOT/src/core/registry.sh"
# shellcheck source=src/core/adapter-deps.sh
. "$APPPILOT_ROOT/src/core/adapter-deps.sh"
# shellcheck source=src/core/env-file.sh
. "$APPPILOT_ROOT/src/core/env-file.sh"
# shellcheck source=src/host/packages.sh
. "$APPPILOT_ROOT/src/host/packages.sh"
# shellcheck source=src/host/detect.sh
. "$APPPILOT_ROOT/src/host/detect.sh"
# shellcheck source=src/host/resources.sh
. "$APPPILOT_ROOT/src/host/resources.sh"
# shellcheck source=src/host/ports.sh
. "$APPPILOT_ROOT/src/host/ports.sh"
# shellcheck source=src/adapters/pm2.sh
. "$APPPILOT_ROOT/src/adapters/pm2.sh"
# shellcheck source=src/adapters/compose.sh
. "$APPPILOT_ROOT/src/adapters/compose.sh"
# shellcheck source=src/adapters/resolve.sh
. "$APPPILOT_ROOT/src/adapters/resolve.sh"
# shellcheck source=src/security/ssh-audit.sh
. "$APPPILOT_ROOT/src/security/ssh-audit.sh"
# shellcheck source=src/security/firewall-audit.sh
. "$APPPILOT_ROOT/src/security/firewall-audit.sh"
# shellcheck source=src/security/docker-audit.sh
. "$APPPILOT_ROOT/src/security/docker-audit.sh"
# shellcheck source=src/security/permissions-audit.sh
. "$APPPILOT_ROOT/src/security/permissions-audit.sh"
# shellcheck source=src/commands/init.sh
. "$APPPILOT_ROOT/src/commands/init.sh"
# shellcheck source=src/commands/add.sh
. "$APPPILOT_ROOT/src/commands/add.sh"
# shellcheck source=src/commands/env.sh
. "$APPPILOT_ROOT/src/commands/env.sh"
# shellcheck source=src/commands/list.sh
. "$APPPILOT_ROOT/src/commands/list.sh"
# shellcheck source=src/commands/remove.sh
. "$APPPILOT_ROOT/src/commands/remove.sh"
# shellcheck source=src/commands/_operations.sh
. "$APPPILOT_ROOT/src/commands/_operations.sh"
# shellcheck source=src/commands/deploy.sh
. "$APPPILOT_ROOT/src/commands/deploy.sh"
# shellcheck source=src/commands/v0.2/deploy-history.sh
. "$APPPILOT_ROOT/src/commands/v0.2/deploy-history.sh"
# shellcheck source=src/commands/v0.2/clone.sh
. "$APPPILOT_ROOT/src/commands/v0.2/clone.sh"
# shellcheck source=src/commands/v0.2/add-static.sh
. "$APPPILOT_ROOT/src/commands/v0.2/add-static.sh"
# shellcheck source=src/commands/v0.2/health.sh
. "$APPPILOT_ROOT/src/commands/v0.2/health.sh"
# shellcheck source=src/commands/v0.2/backup.sh
. "$APPPILOT_ROOT/src/commands/v0.2/backup.sh"
# shellcheck source=src/commands/v0.2/expose.sh
. "$APPPILOT_ROOT/src/commands/v0.2/expose.sh"
